<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        🔴 النسخ التلقائي مُطفأ: دفترُ التاجر لا يُنسخ إلى حسابٍ لا يملكه.

        النسخ التلقائي في أندرويد يرفع مجلّد بيانات التطبيق إلى Google Drive
        الخاص بحامل الجهاز — ومجلّدنا يحوي مخبأ فايرستور (IndexedDB داخل
        الـWebView): أسماء الزبائن، وأرصدة الديون، والفواتير، ورموز الجلسة.
        فتُستعاد على أي جهازٍ يدخل بذلك الحساب.

        وهذا خطرٌ حقيقي في محلٍّ عراقي: الهاتف قد يكون بحساب غوغل لابنٍ أو
        بائع، والدفتر ليس لهما.

        ولا شيء يُفقد بإطفائه: بيانات المحل في فايرستور، فيسجّل التاجر دخوله
        على الجهاز الجديد فتعود كاملةً — وهذا هو المسار المصمَّم أصلاً.

        السطران معاً لا واحد: `allowBackup` للأنظمة قبل أندرويد ١٢،
        و`dataExtractionRules` لما بعدها (targetSdk = ٣٦) — وهي تحكم النسخ
        السحابي **ونقل الجهاز إلى جهاز** كليهما.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
